# Modo de execução: "webi" (Playwright dirige o WebI) ou "mock" (sem BOE)
MODE=webi

# Lista de CCEs alternativa ao config/cces.json (separada por vírgula)
# CCES=CCE-001,CCE-002,CCE-003

# --- Conexão WebI / BI Launch Pad ---
# Padrão preenchido para a SEFAZ-GO; ajuste se o seu portal for outro.
WEBI_BASE_URL=https://www.consultas.sefaz.go.gov.br/BOE/BI/custom.jsp
WEBI_USERNAME=usuario
WEBI_PASSWORD=senha
WEBI_HEADLESS=true
WEBI_TIMEOUT_MS=60000

# --- Seletores (variam por versão do WebI — ajuste conforme seu ambiente) ---
SEL_USERNAME=#username
SEL_PASSWORD=#password
SEL_LOGIN=button[type="submit"]
SEL_REFRESH=[title="Refresh"]
SEL_REFRESH_DONE=.refresh-complete
SEL_EXPORT=[title="Export"]
