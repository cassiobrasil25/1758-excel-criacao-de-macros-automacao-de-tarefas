# Modo de execução: "webi" (Playwright dirige o WebI) ou "mock" (sem BOE)
MODE=webi

# Lista de CCEs alternativa ao config/cces.json (separada por vírgula)
# CCES=CCE-001,CCE-002,CCE-003

# --- Conexão WebI / BI Launch Pad (SEFAZ-GO) ---
WEBI_BASE_URL=https://www.consultas.sefaz.go.gov.br/BOE/BI/custom.jsp
# URL do documento WebI único (openDocument). Se vazio, usa WEBI_BASE_URL.
WEBI_DOC_URL=

# RECOMENDADO: conectar ao Google Chrome já aberto e logado (reaproveita sessão).
# Inicie o Chrome com: chrome --remote-debugging-port=9222
# e deixe o relatório aberto. Depois defina:
WEBI_CHROME_CDP=http://localhost:9222

# Se preferir LANÇAR um Chrome novo (sem CDP), deixe WEBI_CHROME_CDP vazio:
WEBI_BROWSER_CHANNEL=chrome
WEBI_USERNAME=usuario
WEBI_PASSWORD=senha
WEBI_HEADLESS=false
WEBI_TIMEOUT_MS=120000

# --- Checkpoint / retomada (essencial p/ lotes grandes) ---
# Retoma de onde parou: pula CCEs já concluídos (reusa o .xlsx bruto) e
# reprocessa os que falharam. Defina como "false" para reprocessar tudo.
CHECKPOINT_RESUME=true
# Caminho do checkpoint (padrão: runtime/checkpoint.jsonl)
# CHECKPOINT_PATH=
# Limite de abas por CCE no Excel consolidado (acima disso, só a aba Consolidado)
CONSOLIDATED_MAX_SHEETS=50

# --- Login (só usado no modo Launch) — confirme com `npm run inspect` ---
SEL_USERNAME=#username
SEL_PASSWORD=#password
SEL_LOGIN=button[type="submit"]

# --- Prompt/Export por TEXTO (ids do WebI DHTML são dinâmicos) ---
SEL_PROMPT_CCE_LABEL=Inserir CCE
SEL_RUN_TEXT=Executar
SEL_RETRIEVING_TEXT=Recuperando dados
SEL_EXPORT_TEXT=Exportar
# Diálogo de exportação: formato, prioridade e confirmação
SEL_EXPORT_FORMAT_TEXT=Excel
# Opção que gera dados mais limpos p/ parse (deixe vazio se não souber o texto):
SEL_EXPORT_PRIORITY_TEXT=
SEL_EXPORT_CONFIRM_TEXT=Exportar

# --- Excel ---
# Aba do .xlsx exportado a parsear. Cada aba do relatório vira um worksheet.
# Abas observadas: EFD_MOV, Mov_CFOP_S, MOV_CFOP_E, APur, APur_ST, ARREC, AJUSTE_APUR
WEBI_EXPORT_SHEET=EFD_MOV

# --- Análise: transição de regime (Simples Nacional -> Normal / obrigada à EFD) ---
REGIME_FIELD=Tipo Enquadramento
REGIME_COMPANY_KEY=CNPJ
REGIME_YEAR_FIELD=Ano
# Regex (case-insensitive) que reconhecem cada regime no valor da coluna:
REGIME_SIMPLES_PATTERN=simples
REGIME_NORMAL_PATTERN=normal
# (Opcional) colunas com datas explícitas nos dados extraídos. Se vazias, as
# datas são derivadas dos anos (31/12 do último ano Simples; 01/01 do 1º Normal).
REGIME_DATE_SAIDA_SIMPLES_FIELD=
REGIME_DATE_EFD_FIELD=

# --- Relatório do Levantamento (planilha de origem + as duas datas) ---
# Caminho da planilha de origem em .xlsx (converta o .xls para .xlsx).
LEVANTAMENTO_SOURCE_PATH=config/levantamento.xlsx
# Coluna identificadora p/ casar com os dados SEFAZ (normalizada p/ dígitos):
LEVANTAMENTO_JOIN_KEY=CNPJ
# Aba a ler (vazio = primeira aba):
LEVANTAMENTO_SHEET=

# --- Análise de obrigatoriedade da EFD (relatório OBRIGATORIEDADE EFD) ---
EFD_OBRIGADO_FIELD=OBRIGADO
EFD_PERIOD_FIELD=Ano/Mês (Referência)
EFD_COMPANY_KEY=CNPJ
# Regex que reconhece "obrigado = sim" (S/Sim):
EFD_YES_PATTERN=^s

# --- Auditoria 12.02: Rotatividade de Estoque (CMV = EI + Compras − EF) ---
# Junta as três abas (Estoque, 01 ENTRADAS/Compras, 08 SAÍDAS) por CCE e
# confronta o CMV com as Saídas declaradas.
ROTATIVIDADE_COMPANY_KEY=CCE
# Produto/mercadoria: chave de junção das três abas (NCM = "Cód. do item"):
ROTATIVIDADE_NCM=Cód. do item
ROTATIVIDADE_PERIOD_FIELD=Ano/Mês (Referência)
ROTATIVIDADE_ESTOQUE_INICIAL=Estoque Inicial
ROTATIVIDADE_COMPRAS=Compras
ROTATIVIDADE_ESTOQUE_FINAL=Estoque Final
ROTATIVIDADE_SAIDAS=Saídas
# Tolerância (valor) para considerar CMV ≈ Saídas:
ROTATIVIDADE_TOLERANCE=0.01
