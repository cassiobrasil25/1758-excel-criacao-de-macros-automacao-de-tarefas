# Modo de execução: "webi" (Playwright dirige o WebI) ou "mock" (sem BOE)
MODE=webi

# Lista de CCEs alternativa ao config/cces.json (separada por vírgula)
# CCES=CCE-001,CCE-002,CCE-003

# --- Conexão WebI / BI Launch Pad (SEFAZ-GO) ---
WEBI_BASE_URL=https://www.consultas.sefaz.go.gov.br/BOE/BI/custom.jsp
# URL do documento WebI único (openDocument). Se vazio, usa WEBI_BASE_URL.
WEBI_DOC_URL=

# RECOMENDADO: conectar ao Google Chrome já aberto e logado (reaproveita sessão).
# Inicie o Chrome com: chrome --remote-debugging-port=9222
# e deixe o relatório aberto. Depois defina:
WEBI_CHROME_CDP=http://localhost:9222

# Se preferir LANÇAR um Chrome novo (sem CDP), deixe WEBI_CHROME_CDP vazio:
WEBI_BROWSER_CHANNEL=chrome
WEBI_USERNAME=usuario
WEBI_PASSWORD=senha
WEBI_HEADLESS=false
WEBI_TIMEOUT_MS=120000

# --- Login (só usado no modo Launch) — confirme com `npm run inspect` ---
SEL_USERNAME=#username
SEL_PASSWORD=#password
SEL_LOGIN=button[type="submit"]

# --- Prompt/Export por TEXTO (ids do WebI DHTML são dinâmicos) ---
SEL_PROMPT_CCE_LABEL=Inserir CCE
SEL_RUN_TEXT=Executar
SEL_RETRIEVING_TEXT=Recuperando dados
SEL_EXPORT_TEXT=Exportar
# Diálogo de exportação: formato e confirmação
SEL_EXPORT_FORMAT_TEXT=Excel
SEL_EXPORT_CONFIRM_TEXT=Exportar

# --- Excel ---
# Aba do .xlsx exportado a parsear (vazio = primeira aba). Ex.: EFD_MOV
WEBI_EXPORT_SHEET=
